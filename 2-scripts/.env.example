# Copy this file to .env and adjust the values for your local setup.

# Absolute path to the local SUSE/spacewalk checkout. Leave empty to use a
# sibling directory named "spacewalk" next to the Uyuni checkout.
SPACEWALK_REPO=/absolute/path/to/spacewalk

# Product branch used when no TARGET_BRANCH argument is supplied.
UYUNI_BACKPORT_TARGET_BRANCH=Manager-5.2
